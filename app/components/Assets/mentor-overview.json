  "referFaq": [
    {
      "id": "eligibility",
      "heading": "Eligibility",
      "Faqaccd": [
        {
          "faqHeading": "Who is eligible for the referral bonus?",
          "accdId": "panel1",
          "subfaq": [
            "Any referred individual who completes the admission process and enrolls in one of Accredian's programs is eligible for the referral bonus."
          ]
        },
        {
          "faqHeading": "What are the conditions for eligibility in Accredian's referral program?",
          "accdId": "panel2",
          "subfaq": [
            "The referred individual must be a new inquiry, having had no prior contact with Accredian for any intake or program."
          ]
        }
      ]
    },
    {
      "id": "referral-process",
      "heading": "Referral process",
      "Faqaccd": [
        {
          "faqHeading": "How can I submit a referral to Accredian?",
          "accdId": "panel1",
          "subfaq": [
            "Referrals can be submitted via Accredian's website’s referral section."
          ]
        },
        {
          "faqHeading": "What happens after I submit a referral through the website?",
          "accdId": "panel1",
          "subfaq": [
            "After submitting a referral, an admission counselor from Accredian will contact the referred individual."
          ]
        },
        {
          "faqHeading": "When do both the referrer and the referred individual become eligible for the referral bonus?",
          "accdId": "panel1",
          "subfaq": [
            "Both the referrer and the referred individual become eligible for the referral bonus once the referred individual enrolls in Accredian's program, with the bonus typically given within 30 days of program enrollment."
          ]
        }
      ]
    },
    {
      "id": "t-and-c",
      "heading": "Terms & Conditions",
      "Faqaccd": [
        {
          "faqHeading": "Terms & Conditions",
          "accdId": "panel1",
          "subfaq": [
            "1. **Bonus Processing:** Referral bonuses will be processed within 30 days of the referred individual's admission process completion.",
            "2. **Bonus Distribution:**",
            " - The referral bonus will be credited to both the referrer and the referred person.",
            " - Distribution of bonuses will be processed through direct money transfer to the bank accounts provided by both parties, or it can be deducted or adjusted from pending program fee installments.",
            "3. **Previous Inquiries:**",
            " - The referral bonus will not be processed if Accredian has already received an earlier inquiry or application from the referred individual for any intake or program, and someone from the team is already in contact with them.",
            " - If no one is in touch with the referred individual, credit will be given to the referrer, and the referral bonus will also be released to the referring candidate.",
            "4. **Multiple Referrals:** If multiple referrals are received from the same individual, the referral bonus will be processed for all referrals that have completed their admission process and meet the aforementioned criteria.",
            "5. **Right to Modify:** Accredian reserves the right to modify or terminate the referral program at any time without prior notice."
          ]
        }
      ]
    }
  ],

