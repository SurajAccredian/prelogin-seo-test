  "curriculum": [
    {
      "title": "Introduction to Product Management",
      "week": "4 weeks",
      "id": "introduction-to-product-management",
      "points": [
        "Roles & Responsibilities of a PM",
        "User Research for PMs",
        "Market Research for PMs",
        "Competitive Analysis for PMs"
      ]
    },
    {
      "title": "Product Strategy & Roadmap",
      "week": "4 weeks",
      "id": "product-strategy---roadmap",
      "points": [
        "What is Product Planning Cycle?",
        "Establising Product Vision & Mission",
        "Formulating Product Strategy & Product Goals",
        "What is Product Backlog & Roadmap"
      ]
    },
    {
      "title": "Design Thinking & UI/UX",
      "week": "4 weeks",
      "id": "design-thinking---ui-ux",
      "points": [
        "Design Thinking & UI/UX",
        "Building MVP - Artefacts, Persona Mapping & PRDs",
        "UI/UX for PMs",
        "Designing Mockups,Wireframes, & Prototypes"
      ]
    },
    {
      "title": "Product Engineering",
      "week": "4 weeks",
      "id": "product-engineering",
      "points": [
        "Intoduction to Engineering for Product Managers",
        "LUnderstanding Microservices & Cloud Services",
        "Waterfall & Agile Methodology",
        "Understanding Scrum & Kanban"
      ]
    },
    {
      "title": "Product Marketing & Launch",
      "week": "4 weeks",
      "id": "product-marketing---launch",
      "points": [
        "Product Launch & A/B Testing",
        "Understanding Product Marketing & Consumer Behaviour",
        "Measuring Brand & Impact of Product Marketing",
        "Marketing Ninja Challenge"
      ]
    },
    {
      "title": "Design Discovery",
      "special": "1",
      "id": "project--design-discovery",
      "points": [
        "Design Discovery requires one to apply design thinking concepts to create human-centred and action-oriented solutions. As a PM practitioner you will be competing with the best to solve a complex challenge."
      ]
    },
    {
      "title": "Foundation of Business Analytics",
      "week": "4 weeks",
      "id": "term-6--foundation-of-business-analytics",
      "points": [
        "Introduction to Business Analytics",
        "Data Analytics Fundamentals for Business Analysts",
        "Statistics Basics for Business",
        "Advanced Business Statistics"
      ]
    },
    {
      "title": "Excel Mastery for Business Insights",
      "week": "4 weeks",
      "id": "term-7--excel-mastery-for-business-insights",
      "points": [
        "Excel fundamentals for Business Analysis",
        "Excel Functions & Conditions",
        "Excel Pivot Tables & Reporting",
        "Excel Modelling"
      ]
    },
    {
      "title": "SQL Essentials for Business Intelligence",
      "week": "4 weeks",
      "id": "term-8--sql-essentials-for-business-intelligence",
      "points": [
        "Database Basics for Analysts",
        "SQL Fundamentals for Business Analysis",
        "SQL Operations",
        "Advanced SQL"
      ]
    },
    {
      "title": "Business Analytics with Power BI",
      "week": "4 weeks",
      "id": "term-9--business-analytics-with-power-bi",
      "points": [
        "Power BI for Business reporting",
        "Connecting Data Sources",
        "Data Modelling in Power BI",
        "Functions in Power BI"
      ]
    },
    {
      "title": "Applied Industry Analytics: Case Studies",
      "week": "4 weeks",
      "id": "term-10--applied-industry-analytics--case-studies",
      "points": [
        "Business Analytics in BFSI",
        "Marketing & Telecom Analytics",
        "Healthcare & Manufacturing Analytics",
        "Ecommerce & Supply Chain Analytics"
      ]
    },
    {
      "title": "Business Analytics Capstone",
      "special": "1",
      "id": "project--design-discovery",
      "points": [
        "This capstone project involves advanced data analysis skills through corporate dataset exploration: data acquisition, transformation, exploratory analysis with statistics and visualization, predictive modeling using supervised learning, prescriptive analytics for strategy, and data storytelling for compelling narratives."
      ]
    }
