  "curriculum": [
    {
      "title": "Introduction to Product Management",
      "id": "1",
      "points": [
        "Roles & Responsibilities of a PM",
        "User Research for PMs",
        "Market Research for PMs",
        "Competitive Analysis for PMs"
      ]
    },
    {
      "title": "Product Strategy & Roadmap",
      "id": "2",
      "points": [
        "Product Planning Cycle",
        "Product Vision & Mission",
        "Product Strategy & Product Goals",
        "Product Backlog & Roadmap"
      ]
    },
    {
      "title": "Design Thinking & UI/UX",
      "id": "3",
      "points": [
        "Design Thinking for PMs",
        "Building MVP - Artefacts, Persona Mapping & PRDs",
        "UI/UX for PMs",
        "Mockups, Wireframes & Prototypes"
      ]
    },
    {
      "title": "Product Engineering",
      "id": "4",
      "points": [
        "Engineering for Product Managers",
        "Microservices & Cloud Services",
        "Waterfall & Agile Methodology",
        "Understanding Scrum & Kanban"
      ]
    },
    {
      "title": "Product Marketing & Launch",
      "id": "5",
      "points": [
        "Product Launch & A/B Testing",
        "Data Driven Product Marketing & Consumer Behaviour",
        "Marketing Ninja Challenge"
      ]
    },
    {
      "title": "Design Discovery",
      "special": "1",
      "id": "project--design-discovery",
      "points": [
        "Design Discovery requires one to apply design thinking concepts to create human-centred and action-oriented solutions. As a PM practitioner you will be competing with the best to solve a complex challenge."
      ]
    },
    {
      "title": "Foundations of Data Science",
      "week": "4 weeks",
      "id": "data-analysis-with-python",
      "points": [
        "Introduction to Data Science and Python Basics",
        "Python Foundations",
        "Essential Libraries for Data Science",
        "Practical Implementations"
      ]
    },
    {
      "title": "Statistical Foundations & Data Visualization",
      "week": "4 weeks",
      "id": "data-visualization-techniques",
      "points": [
        "Introduction to Statistics",
        "Advanced Statistical Concepts",
        "Data Visualization",
        "Practical Implementations"
      ]
    },
    {
      "title": "Exploratory Data Analysis",
      "week": "4 weeks",
      "id": "eda---data-storytelling",
      "points": [
        "Data Acquisition & Cleaning",
        "Data Transformation",
        "Exploratory Data Analysis (EDA)",
        "Practical Implementations"
      ]
    },
    {
      "title": "Machine Learning Fundamentals",
      "week": "4 weeks",
      "points": [
        "Introduction to Machine Learning",
        "Supervised Learning Algorithms",
        "Ensemble Learning",
        "Advanced Supervised Learning Algorithms (self-paced)"
      ]
    },
    {
      "title": "Advanced Machine Learning & Model Optimization",
      "week": "4 weeks",
      "id": "machine-learning-foundation",
      "points": [
        "Unsupervised Learning Techniques",
        "Model Tuning & Evaluation",
        "Feature Engineering",
        "Advanced Feature Engineering & Selection (self-paced)"
      ]
    },
    {
      "title": "Capstone Project",
      "special": "1",
      "id": "major-capstone-project",
      "points": [
        "As a data scientist, you'll tackle a key business challenge by aligning with company goals and preparing data for analysis. Using techniques like machine learning, you’ll derive actionable insights and develop a scalable solution. Collaborating with your team, you’ll create a comprehensive report with recommendations and metrics. This capstone mirrors real-world scenarios, showcasing your technical and teamwork skills."
      ]
    }
