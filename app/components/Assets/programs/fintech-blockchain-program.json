  "curriculum": [
    {
      "title": "FinTech Ecosystem",
      "week": "4 weeks",
      "id": "fintech-ecosystem",
      "points": [
        "Introduction to FinTech",
        "Evolution of FinTech",
        "FinTech Typology: FinTech vs Techfin",
        "Latest Trends and Future of FinTech",
        "BFSI Sector and FinTech: Opportunities & Challenges",
        "FinTech Use Cases for BFSI"
      ]
    },
    {
      "title": "Payment Technology",
      "week": "4 weeks",
      "id": "payment-technology",
      "points": [
        "Digital Banking System in India",
        "Real-Time Gross Settlement (RTGS) Systems",
        "Individual Payments & Digital Payment System",
        "Consumer and Retail Payment Innovation",
        "Payment Architecture and Technology",
        "Mobile Money, Mobile Wallet, UPI, IMPS",
        "CBDC Retail: E-Rupee",
        "Digital Financial Services & Regulations"
      ]
    },
    {
      "title": "Financial Risk Management",
      "week": "4 weeks",
      "id": "financial-risk-management",
      "points": [
        "Bank Financial Statement Analysis",
        "Market and Interest Rate Risks",
        "Credit Risks",
        "Operational Risks",
        "Risk Management Strategies",
        "Probability of Default and Credit Scoring"
      ]
    },
    {
      "title": "Lending Technology",
      "week": "4 weeks",
      "id": "lending-technology",
      "points": [
        "Digitalization of Financial Services",
        "Digital Lending Infrastructure in India",
        "P2P Lending and Crowdfunding",
        "BNPL (Buy Now, Pay Later) Services",
        "Neo Banks Development",
        "MSME Lending Landscape in FinTech",
        "Supply Chain Digital Lending Innovations"
      ]
    },
    {
      "title": "Artificial Intelligence/Machine Learning",
      "week": "4 weeks",
      "id": "artificial-intelligence-machine-learning",
      "points": [
        "Introduction to Artificial Intelligence (AI)",
        "AI Applications in Business",
        "Machine Learning Algorithms",
        "Practical AI/ML Implementation",
        "Fraud Detection Using Big Data",
        "Data-Driven Decision Making",
        "Challenges and Future of ML/AI in Risk Management",
        "Additional Use Cases and Applications"
      ]
    },
    {
      "title": "Cloud Computing",
      "week": "3 weeks",
      "id": "cloud-computing",
      "points": [
        "Cloud Computing Architecture",
        "Cloud Technologies",
        "Robust, Secure, and Scalable API Development",
        "API Economy, Open APIs, and Connected Businesses",
        "Allied Use Cases and Applications"
      ]
    },
    {
      "title": "Blockchain Technology and Cryptocurrencies",
      "week": "4 weeks",
      "id": "blockchain-technology-and-cryptocurrencies",
      "points": [
        "Introduction to Blockchain",
        "Distributed Ledger Technology",
        "Hashing, Encryption, and Decryption",
        "Trust Frameworks and Consensus Mechanisms",
        "Public Consortium and Private Blockchains",
        "Cryptocurrencies and Initial Coin Offerings (ICOs)",
        "Smart Contracts and Decentralized Applications (DApps)",
        "Tokenization and Non-Fungible Tokens (NFTs)",
        "Digital Currencies and Central Bank Digital Currencies (CBDCs)",
        "Decentralized Finance (DeFi)",
        "Augmented Reality (AR), Virtual Reality (VR), and Metaverse",
        "Allied Use Cases and Applications"
      ]
    },
    {
      "title": "Data and Cybersecurity Issues",
      "week": "5 weeks",
      "id": "data-and-cybersecurity-issues",
      "points": [
        "History of Data Regulation",
        "Finance Data Usage",
        "Data Analytics in Finance",
        "Cybersecurity Risks in FinTech",
        "Vendor Risk Management",
        "Open Banking APIs and Startups",
        "Digital Identity Verification",
        "Regulation Evolution: KYC to KYD",
        "FinTech Governance",
        "AI and Governance",
        "Data Protection: GDPR Compliance and Privacy"
      ]
    },
    {
      "title": "Regulatory Technology",
      "week": "3 weeks",
      "id": "regulatory-technology",
      "points": [
        "Evolution and Regulations",
        "Promoting FinTech Ecosystem",
        "RegTech Challenges",
        "Regulatory Sandboxes",
        "Smart Regulation and Fraud Detection",
        "Financial Infrastructure Best Practices",
        "Robotic Process Automation (RPA)"
      ]
    },
    {
      "title": "Insurance Technology",
      "week": "3 weeks",
      "id": "insurance-technology",
      "points": [
        "Traditional Insurance Industry",
        "Insurance Service and Technology",
        "Internet of Things (IoT)",
        "Wearables",
        "Allied Use Cases and Applications"
      ]
    },
    {
      "title": "Wealth Technology",
      "week": "3 weeks",
      "id": "wealth-technology",
      "points": [
        "FinTech and Wealth Management",
        "Social Robots in Financial Services",
        "Robo-Advisors",
        "Digital Brokers",
        "AI Chatbots",
        "Investment Management",
        "Portfolio Tracking"
      ]
    },
    {
      "title": "FinTech Startups",
      "week": "3 weeks",
      "id": "fintech-startups",
      "points": [
        "Challenges and Innovations",
        "Design Thinking in FinTech",
        "Digital Strategy and Gamification",
        "Future Outlook for FinTech"
      ]
    }
