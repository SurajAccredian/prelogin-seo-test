  "curriculum": [
    {
      "title": "Introduction to Investment Banking",
      "id": "1",
      "points": [
        "Overview of Investment Banking",
        "Key Functions of Investment Banks",
        "Financial Markets and Instruments",
        "Regulatory Environment"
      ]
    },
    {
      "title": "Financial Statement Analysis",
      "id": "2",
      "points": [
        "Income Statement Analysis",
        "Balance Sheet Analysis",
        "Cash Flow Statement Analysis",
        "Financial Ratios and Metrics"
      ]
    },
    {
      "title": "M&A Valuation Techniques",
      "id": "3",
      "points": [
        "Discounted Cash Flow (DCF) Analysis",
        "Comparable Company Analysis (Comps)",
        "Precedent Transactions Analysis",
        "Valuation Using Market Multiples"
      ]
    },
    {
      "title": "M&A Strategy & Process",
      "id": "4",
      "points": [
        "M&A Strategy and Rationale",
        "Due Diligence and Valuation in M&A",
        "Deal Structuring and Negotiation",
        "Post-Merger Integration and Performance Evaluation",
        "M&A Simulation"
      ]
    },
    {
      "title": "Equity Capital Markets (ECM)",
      "id": "5",
      "points": [
        "IPO Process and Underwriting",
        "Secondary Offerings and Private Placements",
        "Equity Financing Strategies",
        "Market Trends and Analysis"
      ]
    },
    {
      "title": "Debt Capital Markets (DCM)",
      "id": "6",
      "points": [
        "Types of Debt Instruments",
        "Debt Issuance Process and Syndication",
        "Credit Ratings and Risk Assessment",
        "Market Conditions and Trends"
      ]
    },
    {
      "title": "Leveraged Buyouts (LBOs)",
      "id": "7",
      "points": [
        "LBO Structure and Financing",
        "Valuation and Financial Modeling for LBOs",
        "Due Diligence and Risk Assessment",
        "Post-LBO Integration and Management",
        "LBO Simulation"
      ]
    },
    {
      "title": "Financial Restructuring",
      "id": "8",
      "points": [
        "Restructuring Process and Strategies",
        "Bankruptcy and Insolvency Procedures",
        "Debt Restructuring and Refinancing",
        "Turnaround Strategies"
      ]
    },
    {
      "title": "Securities Sales & Trading",
      "id": "9",
      "points": [
        "Equity Sales & Trading",
        "Fixed Income & Derivatives Trading",
        "FX & Commodities Trading",
        "Algorithmic and High-Frequency Trading"
      ]
    },
    {
      "title": "Private Equity & Venture Capital",
      "id": "10",
      "points": [
        "Private Equity Investment Strategies",
        "Venture Capital Funding Stages",
        "Valuation and Deal Structuring",
        "Exit Strategies and Returns",
        "PE Simulation"
      ]
    },
    {
      "title": "Fintech in Investment Banking",
      "id": "11",
      "points": [
        "Digital Transformation in Investment Banking",
        "AI in Deal Sourcing and Matching",
        "Automated Valuation Models",
        "Fintech-driven Innovation and Disruptions"
      ]
    },
    {
      "title": "Capstone Project",
      "special": "1",
      "id": "capstone-project",
      "points": [
        "Develop a valuation model for a mid-sized technology company using DCF, comparable company analysis, and precedent transactions. You'll research industry trends and financials to accurately assess the company's intrinsic value. The final deliverable will include a detailed report with justifications, a sensitivity analysis, and investor recommendations. The project concludes with a presentation to a mock investment committee, where you'll defend your valuation and investment thesis, demonstrating your practical investment banking skills."
      ]
    }
  ],
