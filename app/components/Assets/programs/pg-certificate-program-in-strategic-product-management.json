  "curriculum": [
    {
      "title": "Introduction to Strategic Product Management",
      "week": "5 weeks",
      "id": "introduction-to-strategic-product-management",
      "points": [
        "Introduction to Product Management",
        "Foundations of Strategic Thinking",
        "Understanding Product Vision & Mission",
        "Competitive Analysis & Market Research"
      ]
    },
    {
      "title": "Product Strategy & Roadmap",
      "week": "4 weeks",
      "id": "product-strategy---roadmap",
      "points": [
        "Understanding Business Model Canvas & Value Proposition",
        "Customer Segmentation",
        "Prioritization Frameworks",
        "Product Roadmapping"
      ]
    },
    {
      "title": "Testing Product Market Fit",
      "week": "4 weeks",
      "id": "testing-product-market-fit",
      "points": [
        "Introduction to Product-Market Fit (PMF)",
        "Quantitative Metrics for PMF Assessment",
        "Launching Minimum Viable Product (MVP)",
        "Iterative Development and Continuous Improvement"
      ]
    },
    {
      "title": "Design Strategies for Product Success",
      "week": "5 weeks",
      "id": "design-strategies-for-product-success",
      "points": [
        "User Interface (UI) & User Experience (UX) Design Principles",
        "Design Thinking & Empathy-Driven Design",
        "Information Architecture & Navigation Design",
        "A/B Testing for Design Optimization"
      ]
    },
    {
      "title": "Agile Product Development",
      "week": "4 weeks",
      "id": "agile-product-development",
      "points": [
        "Scrum Framework & Team Roles",
        "Agile Ceremonies & Sprint Management",
        "Prioritization & Backlog Refinement Techniques",
        "Continuous Improvement & Experimentation"
      ]
    },
    {
      "title": "Go-to-Market (GTM)",
      "week": "4 weeks",
      "id": "go-to-market--gtm-",
      "points": [
        "Product Marketing & Branding Strategies",
        "User Acquisition & Retention Channels",
        "Launch Planning & Execution Tactics",
        "Measuring GTM Success & Growth Hacking"
      ]
    },
    {
      "title": "Analytics & Data-Driven Product Strategies",
      "week": "5 weeks",
      "id": "analytics---data-driven-product-strategies",
      "points": [
        "Defining Product Success Metrics & KPIs",
        "Data Analysis & Storytelling for Product Decisions",
        "Effective Dashboards & Reporting Techniques",
        "Building a Data-Driven Product Culture"
      ]
    },
    {
      "title": "Pricing Strategies",
      "week": "4 weeks",
      "id": "pricing-strategies",
      "points": [
        "Pricing Fundamentals & Value Frameworks",
        "Psychological Pricing & Consumer Behavior",
        "A/B Testing & Data-Driven Pricing Decisions",
        "Advanced Pricing Strategies & Monetization Models"
      ]
    },
    {
      "title": "Global Product Management",
      "week": "4 weeks",
      "id": "global-product-management",
      "points": [
        "Global Market Landscape & Entry Strategies",
        "Legal, Regulatory, & Compliance Requirements",
        "Go-to-Market & Localization Strategies",
        "Managing Global Product Teams & Operations"
      ]
    },
    {
      "title": "Capstone Project: Product Innovation Challenge",
      "special": "1",
      "id": "capstone-project--product-innovation-challenge",
      "points": [
        "Analyzing World-class Challenges",
        "Crafting Winning Elevator Pitches",
        "Articulating Effective Go-to-Market (GTM) Strategies",
        "Showcasing Achievements on Demo Day"
      ]
    }
  ],
