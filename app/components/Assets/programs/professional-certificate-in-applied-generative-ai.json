    {
      "title": "Capstone Project",
      "id": "capstone-project",
      "special": "1",
      "points": [
        "Identify One Real Process From Your Organization (E.g., Lead Nurturing, Month-End Reporting, Hiring, Ticket Triage). Map The Current Workflow, Then Design A GenAI-Augmented Version Using LLMs, RAG & No/Low-Code Tools. Build A Working Assistant Or Copilot Prototype, Run A Small Pilot With Sample Data, & Quantify Impact On Time, Quality, & Decision-Making."
      ]
    }
