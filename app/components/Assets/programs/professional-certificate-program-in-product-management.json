  "curriculum": [
    {
      "title": "Fundamentals of Product Management",
      "week": "4 weeks",
      "id": "fundamentals-of-product-management",
      "points": [
        "PM Basics: Role, Responsibilities, Skills",
        "Market Analysis & Customer Research",
        "Competitive Analysis for PMs",
        "Product Ideation & Conceptualization"
      ]
    },
    {
      "title": "Product Strategy & Roadmapping",
      "week": "4 weeks",
      "id": "product-strategy---roadmap",
      "points": [
        "Product Vision & Mission",
        "Product Strategy Frameworks",
        "Prioritization & Roadmapping Techniques",
        "Business & Product Strategy Alignment"
      ]
    },
    {
      "title": "User Centered Design & UX",
      "week": "4 weeks",
      "id": "user-experience-design",
      "points": [
        "Design Thinking for PMs",
        "Introduction to UX Design",
        "Information Architecture & Design Process",
        "Empathy-Driven Design Essentials"
      ]
    },
    {
      "title": "Agile Product Development & Execution",
      "week": "4 weeks",
      "id": "agile-product-development",
      "points": [
        "Agile Methodologies Overview",
        "Sprint Planning, Review, & Retrospective",
        "Prioritization & Backlog Refinement Techniques",
        "Agile Metrics & Performance Measurement"
      ]
    },
    {
      "title": "Go-to-Market Strategy & Growth",
      "week": "3 weeks",
      "id": "product-launch---marketing",
      "points": [
        "GTM Strategies & Planning",
        "Product Messaging & Positioning",
        "Marketing Channels for Product Launch"
      ]
    },
    {
      "title": "Product Analytics & AI",
      "week": "3 weeks",
      "id": "product-launch---marketing",
      "points": [
        "Product Success Metrices, KPIs, A/B testing",
        "Data-driven Decision Making in PM",
        "Generative AI Applications in PM"
      ]
    },
    {
      "title": "Capstone Project",
      "special": "1",
      "id": "capstone-project--minor-",
      "points": [
        "In BYOP, participants will undertake comprehensive product  development. We will integrate product management, strategy, and UX design to ensure a solid foundation for our product. As a part of this we will also use Agile methodologies to drive iterative development, with launch and marketing strategies aimed at user attraction. To wrap, we will build sustainable growth plans, supported by product analytics and generative AI, to achieve product innovation."
      ]
    }
  ],
